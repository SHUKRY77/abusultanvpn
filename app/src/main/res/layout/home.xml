<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFFFF">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@id/main_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="42dp"
                android:paddingTop="14dp"
                android:paddingRight="42dp"
                android:paddingBottom="26dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:src="@drawable/ic_app_icon"
                        android:contentDescription="YEMEN NET VPN" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingLeft="12dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="YEMEN NET VPN"
                            android:textColor="#111111"
                            android:textSize="25sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Secure VPN connection"
                            android:textColor="#777777"
                            android:textSize="13sp" />
                    </LinearLayout>
                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_menu"
                        android:onClick="menu"
                        app:tint="#0878A8"
                        android:contentDescription="Menu" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@id/bytes_in"
                        android:text="↓ 0 B"
                        android:textColor="#0878A8"
                        android:textSize="17sp" />
                    <TextView
                        android:id="@id/bytes_out"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="80dp"
                        android:text="↑ 0 B"
                        android:textColor="#0878A8"
                        android:textSize="17sp" />
                </LinearLayout>

                <TextView
                    android:id="@id/status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="Disconnected"
                    android:textColor="#00C853"
                    android:textSize="22sp"
                    android:textStyle="bold" />
                <ImageView
                    android:id="@id/status_icon"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="gone" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Config Version : 1.0   |   VPN Duration : 00h 00m 00s"
                    android:textColor="#555555"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/config_version"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="76dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/hiba_server_card_bg"
                    android:gravity="center_vertical"
                    android:paddingLeft="16dp"
                    android:paddingRight="12dp">
                    <ImageView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:src="@drawable/ic_app_icon"
                        android:contentDescription="Auto Select Server" />
                    <Spinner
                        android:id="@id/profile"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginLeft="10dp"
                        android:spinnerMode="dialog" />
                    <ImageButton
                        android:id="@id/profile_edit"
                        android:layout_width="1dp"
                        android:layout_height="1dp"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="76dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/hiba_server_card_bg"
                    android:gravity="center_vertical"
                    android:paddingLeft="16dp"
                    android:paddingRight="12dp">
                    <ImageView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:src="@drawable/ic_web"
                        android:contentDescription="Network" />
                    <Spinner
                        android:id="@+id/network_spin"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginLeft="10dp"
                        android:spinnerMode="dialog" />
                </LinearLayout>

                <TextView
                    android:id="@+id/expire_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="12dp"
                    android:text="ACCOUNT EXPIRY  ·  0 Days Left"
                    android:textColor="#555555"
                    android:textSize="12sp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="218dp"
                    android:layout_marginTop="12dp">
                    <Button
                        android:id="@id/connect"
                        android:layout_width="190dp"
                        android:layout_height="190dp"
                        android:layout_gravity="center"
                        android:background="@drawable/hiba_power_button"
                        android:textColor="#00000000"
                        android:text="" />
                    <Button
                        android:id="@id/disconnect"
                        android:layout_width="190dp"
                        android:layout_height="190dp"
                        android:layout_gravity="center"
                        android:background="@drawable/hiba_power_button"
                        android:textColor="#00000000"
                        android:text="" />
                    <app.ovpnudp.developer.view.CircleProgressBar
                        android:id="@+id/custom_progressBar"
                        android:layout_width="198dp"
                        android:layout_height="198dp"
                        android:layout_gravity="center"
                        app:progress="0"
                        app:progressBarThickness="1dp"
                        app:progressbarColor="#FFFFFFFF" />
                </FrameLayout>

                <TextView
                    android:id="@+id/duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="00:00:00"
                    android:textColor="#333333"
                    android:textSize="16sp"
                    android:layout_marginTop="-12dp"
                    android:visibility="visible" />

                <LinearLayout android:id="@id/profile_group" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
                <LinearLayout android:id="@id/proxy_group" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
                <LinearLayout android:id="@id/server_group" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
                <LinearLayout android:id="@id/username_group" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
                <LinearLayout android:id="@id/password_group" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
                <LinearLayout android:id="@id/pk_password_group" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
                <LinearLayout android:id="@id/cr_group" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
                <LinearLayout android:id="@id/conn_details_group" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
                <LinearLayout android:id="@id/stats_group" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
                <LinearLayout android:id="@id/stats_expansion_group" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
                <LinearLayout android:id="@id/info_group" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
                <View android:id="@id/post_import_help_blurb" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
                <View android:id="@id/conn_details_boxed" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
                <Spinner android:id="@id/server" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
                <Spinner android:id="@id/proxy" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
                <ImageButton android:id="@id/proxy_edit" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
                <TextView android:id="@id/challenge" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
                <EditText android:id="@id/username" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
                <EditText android:id="@id/password" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
                <EditText android:id="@id/pk_password" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
                <EditText android:id="@id/response" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
                <CheckBox android:id="@id/password_save" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
                <CheckBox android:id="@id/pk_password_save" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
                <ProgressBar android:id="@id/progress" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
                <TextView android:id="@id/details_more_less" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
                <TextView android:id="@id/last_pkt_recv" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
                <LinearLayout android:id="@+id/network_layout" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
                <TextView android:id="@+id/network_title" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
                <TextView android:id="@+id/network_info" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
                <ImageView android:id="@+id/network_icon" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
                <EditText android:id="@+id/myusername" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
                <EditText android:id="@+id/mypassword" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
                <TextView android:id="@+id/check_update" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
                <FrameLayout android:id="@+id/graph_layout" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
                <TextView android:id="@+id/notice_text" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
                <com.google.android.gms.ads.AdView android:id="@+id/adView" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" app:adSize="BANNER" app:adUnitId="ca-app-pub-2122970527460050/2449299092" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:background="#15A8D9"
        android:gravity="center"
        android:orientation="horizontal">
        <LinearLayout android:id="@+id/b_update" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><ImageView android:layout_width="25dp" android:layout_height="25dp" android:src="@drawable/ic_box_download" app:tint="#FFFFFFFF" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="UPDATES" android:textColor="#123C55" android:textSize="12sp" /></LinearLayout>
        <LinearLayout android:id="@+id/b_tweaks" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><ImageView android:layout_width="25dp" android:layout_height="25dp" android:src="@drawable/tweakers" app:tint="#FFFFFFFF" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LOGS" android:textColor="#123C55" android:textSize="12sp" /></LinearLayout>
        <LinearLayout android:id="@+id/b_exit" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><ImageView android:layout_width="25dp" android:layout_height="25dp" android:src="@drawable/ic_info" app:tint="#FFFFFFFF" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="JOIN US" android:textColor="#123C55" android:textSize="12sp" /></LinearLayout>
        <LinearLayout android:id="@+id/b_exit_real" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><ImageView android:layout_width="25dp" android:layout_height="25dp" android:src="@drawable/ic_arrow_right" app:tint="#FFFFFFFF" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="EXIT" android:textColor="#123C55" android:textSize="12sp" /></LinearLayout>
    </LinearLayout>
</LinearLayout>
